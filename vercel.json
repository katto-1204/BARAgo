{
  "buildCommand": "npm run build -w @workspace/barago && node scripts/prepare-vercel-output.mjs",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://workspaceapi-server-production-d4d6.up.railway.app/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
